{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Sukna w Khazinah (سكنة وخزينة) design tokens v1.0 — single source of truth. Run `python3 scripts/build_tokens.py` to regenerate tokens.css, tailwind.preset.js and contrast-report.md.",
  "color": {
    "brand": {
      "green":  { "$type": "color", "$value": "#02C277", "$description": "أخضر سكنة · Sukna Green — official. RGB 2 194 119. Home, growth, the first benefit." },
      "yellow": { "$type": "color", "$value": "#F0FF0B", "$description": "أصفر خزينة · Khazinah Yellow — official. RGB 240 255 11. Treasury, value, the asset you keep." },
      "deep":   { "$type": "color", "$value": "#00563A", "$description": "أخضر عميق · Deep Green — supporting. Text and links on yellow/white (AAA)." },
      "ink":    { "$type": "color", "$value": "#0B2A1E", "$description": "حبر · Ink — supporting. Default text; the only text colour allowed on Sukna Green." },
      "paper":  { "$type": "color", "$value": "#F6F8F5", "$description": "ورق · Paper — supporting. Calm surface for long reading." },
      "white":  { "$type": "color", "$value": "#FFFFFF" }
    },
    "green": {
      "50":  { "$type": "color", "$value": "#E8FAF2" },
      "100": { "$type": "color", "$value": "#C6F2DF" },
      "200": { "$type": "color", "$value": "#94E6C4" },
      "300": { "$type": "color", "$value": "#5CD8A5" },
      "400": { "$type": "color", "$value": "#2BCC8B" },
      "500": { "$type": "color", "$value": "#02C277" },
      "600": { "$type": "color", "$value": "#00A666" },
      "700": { "$type": "color", "$value": "#007A4C" },
      "800": { "$type": "color", "$value": "#00563A" },
      "900": { "$type": "color", "$value": "#003D29" },
      "950": { "$type": "color", "$value": "#0B2A1E" }
    },
    "yellow": {
      "50":  { "$type": "color", "$value": "#FDFFE5" },
      "100": { "$type": "color", "$value": "#FBFFC2" },
      "200": { "$type": "color", "$value": "#F7FF8A" },
      "300": { "$type": "color", "$value": "#F4FF52" },
      "400": { "$type": "color", "$value": "#F2FF2E" },
      "500": { "$type": "color", "$value": "#F0FF0B" },
      "600": { "$type": "color", "$value": "#D4E200" },
      "700": { "$type": "color", "$value": "#A6B100" },
      "800": { "$type": "color", "$value": "#747C00" },
      "900": { "$type": "color", "$value": "#4A4F00" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F6F8F5" },
      "100": { "$type": "color", "$value": "#ECF0EC" },
      "200": { "$type": "color", "$value": "#D9E0DA" },
      "300": { "$type": "color", "$value": "#BAC5BD" },
      "400": { "$type": "color", "$value": "#8E9C93" },
      "500": { "$type": "color", "$value": "#5E6D64" },
      "600": { "$type": "color", "$value": "#4C5A52" },
      "700": { "$type": "color", "$value": "#36423B" },
      "800": { "$type": "color", "$value": "#222C26" },
      "900": { "$type": "color", "$value": "#141B17" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#007A4C" },
      "warning": { "$type": "color", "$value": "#9A6700" },
      "danger":  { "$type": "color", "$value": "#C2341F" },
      "info":    { "$type": "color", "$value": "#1D6FD1" }
    },
    "semantic": {
      "bg-canvas":       { "$type": "color", "$value": "{color.neutral.0}" },
      "bg-subtle":       { "$type": "color", "$value": "{color.brand.paper}" },
      "bg-brand":        { "$type": "color", "$value": "{color.brand.yellow}" },
      "bg-brand-alt":    { "$type": "color", "$value": "{color.brand.green}" },
      "bg-inverse":      { "$type": "color", "$value": "{color.brand.ink}" },
      "text-primary":    { "$type": "color", "$value": "{color.brand.ink}" },
      "text-secondary":  { "$type": "color", "$value": "{color.neutral.600}" },
      "text-muted":      { "$type": "color", "$value": "{color.neutral.500}" },
      "text-on-brand":   { "$type": "color", "$value": "{color.brand.ink}" },
      "text-on-inverse": { "$type": "color", "$value": "{color.brand.yellow}" },
      "text-link":       { "$type": "color", "$value": "{color.brand.deep}" },
      "border":          { "$type": "color", "$value": "{color.neutral.200}" },
      "border-strong":   { "$type": "color", "$value": "{color.brand.ink}" },
      "focus-ring":      { "$type": "color", "$value": "{color.brand.ink}" },
      "accent":          { "$type": "color", "$value": "{color.brand.green}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Changa", "IBM Plex Sans Arabic", "Tahoma", "sans-serif"], "$description": "Headlines. Geometric Kufi structure echoing the logo." },
      "text":    { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "Tahoma", "Arial", "sans-serif"], "$description": "Body, UI, data, legal text." },
      "numeric": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "sans-serif"], "$description": "Numbers — use tabular-nums for tables." }
    },
    "weight": {
      "regular":   { "$type": "fontWeight", "$value": 400 },
      "medium":    { "$type": "fontWeight", "$value": 500 },
      "semibold":  { "$type": "fontWeight", "$value": 600 },
      "bold":      { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "size": {
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "md":   { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" },
      "4xl":  { "$type": "dimension", "$value": "36px" },
      "5xl":  { "$type": "dimension", "$value": "48px" },
      "6xl":  { "$type": "dimension", "$value": "60px" },
      "7xl":  { "$type": "dimension", "$value": "72px" },
      "8xl":  { "$type": "dimension", "$value": "96px" }
    },
    "line-height": {
      "tight":   { "$type": "number", "$value": 1.15, "$description": "Display sizes ≥ 48px." },
      "heading": { "$type": "number", "$value": 1.35 },
      "body":    { "$type": "number", "$value": 1.75, "$description": "Arabic needs room for dots and marks." }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "24px" },
    "6":  { "$type": "dimension", "$value": "32px" },
    "7":  { "$type": "dimension", "$value": "40px" },
    "8":  { "$type": "dimension", "$value": "48px" },
    "9":  { "$type": "dimension", "$value": "64px" },
    "10": { "$type": "dimension", "$value": "80px" },
    "11": { "$type": "dimension", "$value": "96px" },
    "12": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "none":    { "$type": "dimension", "$value": "0px" },
    "sm":      { "$type": "dimension", "$value": "2px" },
    "md":      { "$type": "dimension", "$value": "4px" },
    "lg":      { "$type": "dimension", "$value": "8px" },
    "pill":    { "$type": "dimension", "$value": "999px", "$description": "Only for the dot motif (badges, step dots)." },
    "chamfer": { "$type": "dimension", "$value": "14px", "$description": "Signature cut corner taken from the logo's bevelled terminals. Applied with clip-path." }
  },
  "border": {
    "width-hairline": { "$type": "dimension", "$value": "1px" },
    "width-strong":   { "$type": "dimension", "$value": "2px" },
    "width-rule":     { "$type": "dimension", "$value": "4px", "$description": "Ascent rule (the logo's underline)." }
  },
  "shadow": {
    "sm":    { "$type": "shadow", "$value": "0 1px 2px rgba(11,42,30,.08), 0 1px 1px rgba(11,42,30,.04)" },
    "md":    { "$type": "shadow", "$value": "0 6px 16px rgba(11,42,30,.10), 0 2px 4px rgba(11,42,30,.06)" },
    "lg":    { "$type": "shadow", "$value": "0 18px 40px rgba(11,42,30,.14), 0 4px 10px rgba(11,42,30,.06)" },
    "block": { "$type": "shadow", "$value": "-6px 6px 0 #0B2A1E", "$description": "Poster-style hard shadow. Campaign surfaces only, one per view." }
  },
  "angle": {
    "ascent": { "$type": "number", "$value": -7.5, "$description": "Degrees. The logo's rising baseline (≈7.5°, right side higher). Use for rules, bands and motion paths." }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "480px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  },
  "layout": {
    "container":   { "$type": "dimension", "$value": "1200px" },
    "gutter":      { "$type": "dimension", "$value": "24px" },
    "columns":     { "$type": "number", "$value": 12 },
    "page-margin": { "$type": "dimension", "$value": "16px", "$description": "Mobile side margin; 32px ≥ md, 48px ≥ xl." }
  },
  "motion": {
    "duration": {
      "instant":   { "$type": "duration", "$value": "80ms",   "$description": "State feedback: press, toggle." },
      "fast":      { "$type": "duration", "$value": "160ms",  "$description": "Hover, focus, small fades." },
      "base":      { "$type": "duration", "$value": "240ms",  "$description": "Most UI transitions." },
      "moderate":  { "$type": "duration", "$value": "360ms",  "$description": "Panels, cards entering." },
      "slow":      { "$type": "duration", "$value": "560ms",  "$description": "Page-level, hero content." },
      "beat":      { "$type": "duration", "$value": "600ms",  "$description": "One beat of the two-beat rhythm." },
      "pause":     { "$type": "duration", "$value": "300ms",  "$description": "The rest between beat 1 and beat 2 (the '5 years')." },
      "signature": { "$type": "duration", "$value": "2400ms", "$description": "Full logo reveal." }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "enter":      { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
      "exit":       { "$type": "cubicBezier", "$value": [0.3, 0, 0.8, 0.15] },
      "ascend":     { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Signature: fast lift, long settle." },
      "draw":       { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$description": "Rules drawing across." },
      "pop":        { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "Dots only — small overshoot." }
    },
    "distance": {
      "nudge":  { "$type": "dimension", "$value": "4px" },
      "rise":   { "$type": "dimension", "$value": "16px" },
      "travel": { "$type": "dimension", "$value": "48px" }
    },
    "stagger": {
      "tight":   { "$type": "duration", "$value": "40ms" },
      "content": { "$type": "duration", "$value": "80ms" },
      "dots":    { "$type": "duration", "$value": "70ms" }
    }
  }
}
